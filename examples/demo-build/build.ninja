build old/CMakeFiles/gui.dir/src/window.cpp.o: CXX_COMPILER__old old/window.cpp
build old/libcore.a: CXX_STATIC_LIBRARY_LINKER__old old/CMakeFiles/core.dir/src/config.cpp.o
build old/NinjaDemo: CXX_EXECUTABLE_LINKER__old old/libcore.a

build NinjaDemo_autogen/timestamp: NinjaDemo_autogen CMakeFiles/NinjaDemo_autogen
build CMakeFiles/core.dir/src/hash.c.o: C_COMPILER__core src/hash.c
build CMakeFiles/core.dir/src/parser.cpp.o: CXX_COMPILER__core src/parser.cpp
